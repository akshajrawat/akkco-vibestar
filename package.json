{
  "name": "akkco-vibestar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src backend electron tests scripts *.json *.md",
    "format:check": "prettier --check src backend electron tests scripts *.json *.md",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "desktop": "npm run dev",
    "desktop:build": "npm run build && electron-builder --linux deb --publish never",
    "desktop:build:windows": "npm run build && electron-builder --win nsis --publish never",
    "check": "npm run lint && npm run typecheck && npm test",
    "start": "electron .",
    "test:live": "VIBESTAR_LIVE_TEST=1 vitest run tests/live.test.ts",
    "test:tui": "vitest run tests/pty.test.ts tests/task-terminal.test.ts",
    "test:desktop": "VIBESTAR_DESKTOP_TEST=1 vitest run tests/desktop.test.ts",
    "test:desktop:pr": "VIBESTAR_PR_DESKTOP_TEST=1 vitest run tests/desktop-pr-analysis.test.ts",
    "test:desktop:output": "VIBESTAR_OUTPUT_DESKTOP_TEST=1 vitest run tests/desktop-agent-output.test.ts",
    "test:windows": "node scripts/test-windows.mjs"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "@eslint/js": "^9.39.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^27.0.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.8.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "zod": "^4.3.0"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "dev.akkco.vibestar",
    "productName": "akkco vibestar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-core",
        "to": "core"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "akkco",
      "executableName": "akkco-vibestar",
      "syncDesktopName": true,
      "icon": "assets/512x512.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  },
  "description": "Local desktop Agent Development Environment for isolated open-source contribution tasks",
  "author": "akkco",
  "homepage": "https://github.com",
  "overrides": {
    "dompurify": "3.4.16"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "desktopName": "akkco-vibestar.desktop",
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
