{
  "name": "akkco-vibestar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "desktop": "npm run dev",
    "desktop:build": "npm run build && electron-builder --linux deb --publish never",
    "desktop:build:windows": "npm run build && electron-builder --win nsis --publish never",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "start": "electron .",
    "test:live": "VIBESTAR_LIVE_TEST=1 vitest run tests/live/live.test.ts",
    "test:tui": "vitest run --project terminals",
    "test:browser:environment": "VIBESTAR_BROWSER_TEST=1 vitest run tests/verification/browser-environment.test.ts",
    "test:desktop": "VIBESTAR_DESKTOP_TEST=1 vitest run tests/desktop/desktop.test.ts",
    "test:desktop:pr": "VIBESTAR_PR_DESKTOP_TEST=1 vitest run tests/desktop/desktop-pr-analysis.test.ts tests/desktop/desktop-pr-watch.test.ts",
    "test:desktop:repair": "VIBESTAR_REPAIR_DESKTOP_TEST=1 vitest run tests/desktop/desktop-pr-repair.test.ts",
    "test:desktop:output": "VIBESTAR_OUTPUT_DESKTOP_TEST=1 vitest run tests/desktop/desktop-agent-output.test.ts",
    "test:desktop:watch": "VIBESTAR_WATCH_DESKTOP_TEST=1 vitest run tests/desktop/desktop-issue-watch.test.ts",
    "test:windows": "node scripts/test-windows.mjs",
    "test:security": "vitest run --project security",
    "test:regression": "vitest run --project unit --project integration --project security --project terminals",
    "verify": "npm run check && npm run test:integration && npm run test:security && npm run test:tui && npm run build",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepush": "npm run check && npm run test:security"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "@eslint/js": "^9.39.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.4.0",
    "lucide-react": "^0.577.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.8.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "zod": "^4.3.0"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "dev.akkco.vibestar",
    "productName": "akkco vibestar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/**/*",
      "LICENSE",
      "docs/third-party-notices.md"
    ],
    "extraResources": [
      {
        "from": "dist-core",
        "to": "core"
      },
      {
        "from": "dist-core/node_modules",
        "to": "core/node_modules"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "akkco",
      "executableName": "akkco-vibestar",
      "syncDesktopName": true,
      "icon": "assets/512x512.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  },
  "description": "Local desktop Agent Development Environment for isolated open-source contribution tasks",
  "author": "akkco",
  "homepage": "https://github.com/akshajrawat/akkco-vibestar#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "desktopName": "akkco-vibestar.desktop",
  "dependencies": {
    "motion": "^14.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshajrawat/akkco-vibestar.git"
  },
  "bugs": {
    "url": "https://github.com/akshajrawat/akkco-vibestar/issues"
  }
}
